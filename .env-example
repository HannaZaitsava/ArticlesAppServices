# ArticlesService API parameters
ARTICLES_SERVICE_ASPNETCORE_ENVIRONMENT=Development
ARTICLES_SERVICE_API_HTTP_PORT=5000
ARTICLES_SERVICE_API_HTTPS_PORT=8081
# секретный ключ для авторизации ArticlesService API в Seq
ARTICLES_SERVICE_SEQ_API_KEY=

# articles-outbox-worker
ARTICLES_OUTBOX_WORKER_ENV=Development

# NotificationService API parameters
NOTIFICATION_SERVICE_DOTNET_ENVIRONMENT=Development
# Секретный ключ для авторизации NotificationService API в Seq
NOTIFICATION_SERVICE_SEQ_API_KEY=your_secret_key_here

# postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_DB_NAME=ArticlesServiceAppDB
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5433

# pgadmin
PGADMIN_DEFAULT_EMAIL=admin@gmail.com
PGADMIN_DEFAULT_PASSWORD=***
PGADMIN_PORT=5051

# Redis parameters
REDIS_HOST=redis_cache
REDIS_PORT=6380

# Seq parameters
SEQ_EXTERNAL_PORT=5341
SEQ_PASSWORD=12345678
SEQ_SERVER_URL=http://seq:80

#kafka
KAFKA_BOOTSTRAP_SERVERS=kafka_local:29092
