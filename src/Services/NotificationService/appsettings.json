{ 
  //Стандартная иерархия уровней (от низшего к высшему): Verbose → Debug → Information → Warning → Error → Fatal
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning", //"Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning" //"Information"
      }
    }
  },
  "Logging": {
    "Seq": {
      "ServerUrl": "http://localhost:5341",
      "ApiKey": "PLACEHOLDER_FOR_PROD" // Необязательно для локальной разработки
    }
  },
  "Kafka": {
    "TopicName": "article-published",
    "DlqTopicName": "article-published.dlq",
    "ReplicationFactor": 3,
    "NumberOfPartitions": 3,
    "Consumer": {
      "BootstrapServers": "broker1:9092,broker2:9092,broker3:9092",
      "GroupId": "notification-service-group",
      // Фоновый поток сам будет отправлять данные в Kafka (т.к. в коде воркера используется StoreOffset)
      "EnableAutoCommit": true,
      // НО он не будет продвигать офсет без нашей команды (StoreOffset)
      "EnableAutoOffsetStore": false,
      // Каждые 5 секунд отправлять накопленный офсет
      "AutoCommitIntervalMs": 5,

      "AutoOffsetReset": "Earliest",
      "QueuedMinMessages": 500,
      "FetchMaxBytes": 5242880,
      "SessionTimeoutMs": 45000,
      "MaxPollIntervalMs": 600000
    },
    "Producer": {
      "BootstrapServers": "broker1:9092,broker2:9092,broker3:9092",
      "Acks": "All",
      "EnableIdempotence": true,
      "MaxInFlight": 5
    }
  },
  "Redis": {
    "RedisUrl": "localhost:6380, password:111, connectTimeout=5000,syncTimeout=5000,abortConnect=false",
    "InstanceName": "NotificationInbox:",
    "IdempotencyTtlSeconds": 259200 // 3 дня
  }
}
